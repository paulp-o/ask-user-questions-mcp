{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@paulp-o/auq-shared",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas.d.ts",
      "import": "./dist/schemas.js"
    },
    "./session/types": {
      "types": "./dist/session/types.d.ts",
      "import": "./dist/session/types.js"
    },
    "./response/format": {
      "types": "./dist/response/format.d.ts",
      "import": "./dist/response/format.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.1"
  }
}