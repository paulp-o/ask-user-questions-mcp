#!/bin/sh
# Default POSIX launcher. It works without Node or install hooks when Bun is
# available; Windows installation replaces this with scripts/auq-node.mjs.
SCRIPT="$0"
while [ -L "$SCRIPT" ]; do
  SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT")" && pwd)"
  SCRIPT="$(readlink "$SCRIPT")"
  [ "${SCRIPT#/}" = "$SCRIPT" ] && SCRIPT="$SCRIPT_DIR/$SCRIPT"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT")" && pwd)"
ENTRY="$SCRIPT_DIR/../dist/bin/auq.js"

if command -v bun >/dev/null 2>&1; then
  exec bun "$ENTRY" "$@"
else
  exec node "$ENTRY" "$@"
fi
