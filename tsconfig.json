{
  "extends": "@tsconfig/node22/tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "jsx": "react",
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@auq/shared": ["./packages/shared/src/index.ts"],
      "@auq/shared/*": ["./packages/shared/src/*"]
    }
  },
  "include": [
    "src",
    "bin"
  ],
  "exclude": [
    "opensrc",
    "src/tui-opentui"
  ]
}
